{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@app/core/*": ["../../packages/core/src/*"],
      "@app/database/*": ["../../packages/database/src/*"]
    }
  },
  "include": ["src/**/*", "test.ts"],
  "exclude": ["node_modules"]
}
