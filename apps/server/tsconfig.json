{
  "extends": "@app/tsconfig/server.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@app/zod/*": ["../../packages/zod/src/*"],
      "@app/env/*": ["../../packages/env/src/*"],
      "@app/core/*": ["../../packages/core/src/*"],
      "@app/error/*": ["../../packages/error/src/*"],
      "@app/types/*": ["../../packages/types/src/*"],
      "@app/logger/*": ["../../packages/logger/src/*"],
      "@app/database/*": ["../../packages/database/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
