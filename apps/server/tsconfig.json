{
  "extends": "@leapercrm/tsconfig/server.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@leapercrm/trpc/*": ["../../packages/trpc/src/*"],
      "@leapercrm/env/*": ["../../packages/env/src/*"],
      "@leapercrm/auth/*": ["../../packages/auth/src/*"],
      "@leapercrm/lib/*": ["../../packages/lib/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
