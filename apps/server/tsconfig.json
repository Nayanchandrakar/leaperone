{
  "extends": "@myleaper/tsconfig/server.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@myleaper/trpc/*": ["../../packages/trpc/src/*"],
      "@myleaper/auth/*": ["../../packages/auth/src/*"],
      "@myleaper/lib/*": ["../../packages/lib/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
