{
  "name": "server",
  "author": "myleaper-organization",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "description": "A Hono server used in web application",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun ./dist/index.js",
    "build": "tsdown",
    "node:start": "node -r dotenv/config ./dist/index.js",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint --write .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@app/database": "workspace:*",
    "@app/trpc": "workspace:*",
    "@app/env": "workspace:*",
    "@app/logger": "workspace:*",
    "dotenv": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/node": "catalog:",
    "tsdown": "^0.14.1",
    "typescript": "catalog:"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./bootstrap": "./dist/bootstrap.js",
    "./config/cors": "./dist/config/cors.js",
    "./hono/server": "./dist/hono/server.js",
    "./types/index": "./dist/types/index.js",
    "./package.json": "./package.json"
  }
}
