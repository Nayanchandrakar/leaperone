{
  "name": "server",
  "author": "myleaper-organization",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "description": "A Hono server used in web application",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun ./dist/index.js",
    "build": "tsdown",
    "node:start": "node -r dotenv/config ./dist/index.js",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint --write .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@app/database": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/error": "workspace:*",
    "@app/nrpc": "workspace:*",
    "@app/env": "workspace:*",
    "dotenv": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js"
}
