{
  "name": "server",
  "author": "leapercrm-organization",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A Hono server used in web application",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun ./dist/src/index.js",
    "build": "tsdown",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint --write .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@leapercrm/auth": "workspace:*",
    "@leapercrm/database": "workspace:*",
    "@leapercrm/env": "workspace:*",
    "@leapercrm/logger": "workspace:*",
    "@leapercrm/trpc": "workspace:*",
    "dotenv": "^17.2.0",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@leapercrm/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.12.9",
    "typescript": "catalog:"
  }
}
