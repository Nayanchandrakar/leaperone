{
  "name": "server",
  "type": "module",
  "private": true,
  "version": "2.0.0",
  "sideEffects": false,
  "main": "./dist/server.mjs",
  "module": "./dist/server.mjs",
  "description": "leaperone server",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint --write .",
    "start": "bun ./dist/server.mjs",
    "dev": "bun --hot src/server.ts",
    "format": "biome check --write .",
    "node:start": "node -r dotenv/config ./dist/server.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@app/core": "workspace:*",
    "@app/database": "workspace:*",
    "@app/env": "workspace:*",
    "@app/error": "workspace:*",
    "@app/session": "workspace:*",
    "@app/types": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/zod": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@hono/node-server": "catalog:",
    "@react-email/render": "catalog:",
    "bcryptjs": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "resend": "catalog:",
    "stripe": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@app/tsconfig": "workspace:*"
  }
}
