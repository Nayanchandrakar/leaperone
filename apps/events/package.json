{
  "name": "events",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "sideEffects": false,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write .",
    "format": "biome check --write .",
    "deploy": "run-s build zip update",
    "clean": "rimraf dist .turbo lambda.zip",
    "zip": "zip -j lambda.zip dist/index.js package.json",
    "update": "aws lambda update-function-code --function-name hello --zip-file fileb://lambda.zip"
  },
  "dependencies": {
    "@app/database": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "npm-run-all2": "catalog:",
    "@app/tsconfig": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
