{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_SERVER_URL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "NEXT_PUBLIC_STRIPE_ANNUAL_PRICE_ID",
        "NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
