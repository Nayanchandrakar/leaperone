{
  "extends": "@myleaper/tsconfig/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@myleaper/ui/*": ["../../packages/ui/src/*"],
      "@myleaper/lib/*": ["../../packages/lib/src/*"],
      "@myleaper/trpc/*": ["../../packages/trpc/src/*"],
      "@myleaper/database/*": ["../../packages/database/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
