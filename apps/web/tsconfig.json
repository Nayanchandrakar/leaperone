{
  "extends": "@app/tsconfig/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@app/ui/*": ["../../packages/ui/src/*"],
      "@app/env/*": ["../../packages/env/src/*"],
      "@app/core/*": ["../../packages/core/src/*"],
      "@app/nrpc/*": ["../../packages/nrpc/src/*"],
      "@app/error/*": ["../../packages/error/src/*"],
      "@app/database/*": ["../../packages/database/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
