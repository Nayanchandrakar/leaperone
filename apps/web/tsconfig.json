{
  "extends": "@leapercrm/tsconfig/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@leapercrm/ui/*": ["../../packages/ui/src/*"],
      "@leapercrm/env/*": ["../../packages/env/src/*"],
      "@leapercrm/trpc/*": ["../../packages/trpc/src/*"],
      "@leapercrm/database/*": ["../../packages/database/src/*"],
      "@leapercrm/logger/*": ["../../packages/logger/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
