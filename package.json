{
  "name": "shadcn-ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "prepare": "husky",
    "lint": "biome lint --write",
    "format": "biome check --write",
    "clean": "rm -rf .turbo && turbo clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@commitlint/config-conventional": "^19.8.1",
    "@leapercrm/biome-config": "workspace:*",
    "@leapercrm/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "turbo": "^2.4.2",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
